generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CLIENTE
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  ATENDIDA
}

model Usuario {
  id                  String         @id @default(uuid())
  nombre              String
  email               String         @unique
  passwordHash        String
  telefono            String?
  rol                 Rol            @default(CLIENTE)
  activo              Boolean        @default(true)
  creadoEn            DateTime       @default(now())

  // Campos de Seguridad Fase 1 (Extra/09)
  failedAttempts      Int            @default(0)
  lockStage           Int            @default(0) // 0 (normal), 1 (7min), 2 (5h)
  lockedUntil         DateTime?
  permanentlyLocked   Boolean        @default(false)
  tokenVersion        Int            @default(0)
  twoFactorEnabled    Boolean        @default(false)
  twoFactorSecretEnc  String?
  twoFactorLastStep   Int?
  emailVerificadoEn   DateTime?
  eliminadoEn         DateTime?

  // Relaciones
  citas               Cita[]         @relation("PacienteCitas")
  doctorPerfil        Doctor?        @relation("UsuarioDoctor")
  recoveryCodes       RecoveryCode[]
}

model RecoveryCode {
  id        String    @id @default(uuid())
  usuarioId String
  codeHash  String
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  accion    String
  entidad   String?
  entidadId String?
  detalle   Json?
  ip        String?
  creadoEn  DateTime @default(now())

  @@index([creadoEn])
  @@index([actorId])
  @@index([accion])
}

model Especialidad {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  creadoEn    DateTime @default(now())

  doctores    Doctor[]
}

model Doctor {
  id             String       @id @default(uuid())
  usuarioId      String?      @unique
  nombre         String
  biografia      String?
  activo         Boolean      @default(true)
  especialidadId String
  creadoEn       DateTime     @default(now())

  // Relaciones
  usuario        Usuario?     @relation("UsuarioDoctor", fields: [usuarioId], references: [id], onDelete: SetNull)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)
  horarios       Horario[]
  citas          Cita[]
}

model Horario {
  id         String   @id @default(uuid())
  doctorId   String
  diaSemana  Int
  horaInicio String
  horaFin    String

  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Cita {
  id         String     @id @default(uuid())
  pacienteId String
  doctorId   String
  fecha      DateTime
  horaInicio String
  horaFin    String
  estado     EstadoCita @default(CONFIRMADA)
  creadoEn   DateTime   @default(now())

  paciente   Usuario    @relation("PacienteCitas", fields: [pacienteId], references: [id], onDelete: Cascade)
  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, fecha])
  @@index([pacienteId])
}
